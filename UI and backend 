                    <div class="form-group"><label>Price</label><input type="number" step="0.01" name="price" required></div>
                    <button type="submit">Submit Product</button>
                </form>
            </div>

            <div class="form-card">
                <h3>🛒 Add Order</h3>
                <form action="/add-order" method="POST">
                    <div class="form-group"><label>Product ID</label><input type="number" name="product_id" required></div>
                    <div class="form-group"><label>Quantity</label><input type="number" name="quantity" required></div>
                    <button type="submit">Submit Order</button>
                </form>
            </div>

            <div class="form-card">
                <h3>🏭 Add Supplier</h3>
                <form action="/add-supplier" method="POST">
                    <div class="form-group"><label>Supplier Name</label><input type="text" name="supplier_name" required></div>
                    <div class="form-group"><label>Phone Number</label><input type="text" name="phone"></div>
                    <button type="submit">Submit Supplier</button>
                </form>
            </div>

            <div class="form-card">
                <h3>👤 Add Customer</h3>
                <form action="/add-customer" method="POST">
                    <div class="form-group"><label>Customer Name</label><input type="text" name="customer_name" required></div>
                    <div class="form-group"><label>Email Address</label><input type="email" name="email"></div>
                    <button type="submit">Submit Customer</button>
                </form>
            </div>
        </div>
    </div>
    </body>
    </html>
    """


@app.route('/')
def index():
    return get_html_content()


@app.route('/add-product', methods=['POST'])
def add_product():
    connection = connecting_database()
    cursor = connection.cursor()
    query = "INSERT INTO products (product_name, category_id, supplier_id, price) VALUES (%s, %s, %s, %s)"
    values = (
        request.form.get('product_name'),
        request.form.get('category_id'),
        request.form.get('supplier_id'),
        request.form.get('price'),
    )
    try:
        cursor.execute(query, values)
        connection.commit()
    except mysql.connector.Error as err:
        connection.rollback()
        return f"Database Error: {err}", 500
    finally:
        cursor.close()
        connection.close()
    return redirect(url_for('index'))


@app.route('/add-order', methods=['POST'])
def add_order():
    connection = connecting_database()
    cursor = connection.cursor()

    try:
        # Step 1: Create the main order record
        cursor.execute("INSERT INTO orders () VALUES ()")
        new_order_id = cursor.lastrowid

        # Step 2: Look up the product's current price
        cursor.execute(
            "SELECT price FROM products WHERE product_id = %s",
            (request.form.get('product_id'),),
        )
        result = cursor.fetchone()
        if result is None:
            connection.rollback()
            return "Product ID not found", 400
        unit_price = result[0]

        # Step 3: Insert the order line with the price
        query_items = (
            "INSERT INTO order_items (order_id, product_id, quantity, unit_price) "
            "VALUES (%s, %s, %s, %s)"
        )
        values = (
            new_order_id,
            request.form.get('product_id'),
            request.form.get('quantity'),
            unit_price,
        )
        cursor.execute(query_items, values)
        connection.commit()
    except mysql.connector.Error as err:
        connection.rollback()
        return f"Database Error: {err}", 500
    finally:
        cursor.close()
        connection.close()

    return redirect(url_for('index'))


