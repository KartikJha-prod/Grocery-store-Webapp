from html import escape

import pandas as pd
from flask import Flask, request, redirect, url_for
import mysql.connector

from database_grocery_store import connecting_database

app = Flask(__name__)


def get_html_content():
    connection = connecting_database()

    try:
        # 1. Products
        df_p = pd.read_sql_query("SELECT * FROM products;", connection)
        product_rows = ""
        for _, row in df_p.iterrows():
            product_rows += (
                f"<tr><td><strong>{escape(str(row.get('product_id', '')))}</strong></td>"
                f"<td>{escape(str(row.get('product_name', '')))}</td>"
                f"<td>{escape(str(row.get('category_id', '')))}</td>"
                f"<td>{escape(str(row.get('supplier_id', '')))}</td>"
                f"<td>${row.get('price', 0.0):.2f}</td></tr>"
            )

        # 2. Orders (orders JOIN order_items)
        query_orders = """
            SELECT o.order_id, oi.product_id, oi.quantity, oi.unit_price
            FROM orders o
            JOIN order_items oi ON o.order_id = oi.order_id;
        """
        df_o = pd.read_sql_query(query_orders, connection)
        order_rows = ""
        for _, row in df_o.iterrows():
            order_rows += (
                f"<tr><td><strong>{escape(str(row.get('order_id', '')))}</strong></td>"
                f"<td>{escape(str(row.get('product_id', '')))}</td>"
                f"<td>{escape(str(row.get('quantity', '')))}</td>"
                f"<td>${row.get('unit_price', 0.0):.2f}</td></tr>"
            )

        # 3. Suppliers
        df_s = pd.read_sql_query("SELECT * FROM suppliers;", connection)
        supplier_rows = ""
        for _, row in df_s.iterrows():
            supplier_rows += (
                f"<tr><td><strong>{escape(str(row.get('supplier_id', '')))}</strong></td>"
                f"<td>{escape(str(row.get('supplier_name', '')))}</td>"
                f"<td>{escape(str(row.get('phone', '')))}</td></tr>"
            )

        # 4. Customers
        df_c = pd.read_sql_query("SELECT * FROM customers;", connection)
        customer_rows = ""
        for _, row in df_c.iterrows():
            customer_rows += (
                f"<tr><td><strong>{escape(str(row.get('customer_id', '')))}</strong></td>"
                f"<td>{escape(str(row.get('customer_name', '')))}</td>"
                f"<td>{escape(str(row.get('email', '')))}</td></tr>"
            )
    finally:
        connection.close()

    return f"""<!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Database Dashboard</title>
        <style>
            body {{ font-family: 'Segoe UI', sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; color: #333; }}
            .dashboard-container {{ max-width: 1200px; margin: 0 auto; }}
            .oval-container {{ background: #ffffff; border-radius: 30px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 30px; border: 1px solid #e0e0e0; overflow-x: auto; }}
            h2 {{ color: #2c3e50; margin-top: 0; }}
            h3 {{ color: #34495e; border-bottom: 2px solid #ecf0f1; padding-bottom: 5px; }}
            table {{ width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 20px; }}
            th, td {{ padding: 10px 12px; text-align: left; border-bottom: 1px solid #ddd; }}
            th {{ background-color: #f8f9fa; color: #2c3e50; }}
            .forms-grid {{ display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 20px; }}
            .form-card {{ background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }}
            .form-group {{ margin-bottom: 12px; }}
            label {{ display: block; margin-bottom: 5px; font-weight: 600; font-size: 0.9em; }}
            input {{ width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }}
            button {{ background-color: #3498db; color: white; border: none; padding: 10px 15px; border-radius: 6px; cursor: pointer; width: 100%; font-weight: bold; }}
            button:hover {{ background-color: #2980b9; }}
        </style>
    </head>
    <body>

    <div class="dashboard-container">
        <div class="oval-container">
            <h2>📦 Live Database System Tables</h2>

            <h3>Products</h3>
            <table>
                <thead><tr><th>Product ID</th><th>Product</th><th>Category ID</th><th>Supplier ID</th><th>Price</th></tr></thead>
                <tbody>{product_rows}</tbody>
            </table>

            <h3>Orders</h3>
            <table>
                <thead><tr><th>Order ID</th><th>Product ID</th><th>Quantity</th><th>Unit Price</th></tr></thead>
                <tbody>{order_rows}</tbody>
            </table>

            <h3>Suppliers</h3>
            <table>
                <thead><tr><th>Supplier ID</th><th>Supplier Name</th><th>Phone Number</th></tr></thead>
                <tbody>{supplier_rows}</tbody>
            </table>

            <h3>Customers</h3>
            <table>
                <thead><tr><th>Customer ID</th><th>Customer Name</th><th>Email</th></tr></thead>
                <tbody>{customer_rows}</tbody>
            </table>
        </div>

        <h2>Add New Records</h2>
        <div class="forms-grid">
            <div class="form-card">
                <h3>📦 Add Product</h3>
